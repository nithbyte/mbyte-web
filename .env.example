# MByte Admin Web Environment Configuration
# Local Development API URL (connects to NestJS backend on port 4000)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_TENANT_ID=org_novis_001
# Root domain for multi-tenant subdomain routing (localhost:3000 in dev, custom domain in prod)
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
# Google Maps API Key for GIS Telemetry & Maps Integration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Set to 'true' only to enable isolated offline mock data in development
NEXT_PUBLIC_ENABLE_MOCKS=false
